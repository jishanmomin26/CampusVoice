# ==============================================================================
# CampusVoice Backend Environment Configuration Example
# Copy this file to .env and configure your environment-specific credentials.
# Do NOT commit .env to version control.
# ==============================================================================

# Database Connection (PostgreSQL with SQLAlchemy 2.x and psycopg3 driver)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/campusvoice

# Frontend CORS Configuration
# Set ENVIRONMENT to "development" (default) or "production"
ENVIRONMENT=development
# Allowed frontend origin in development
FRONTEND_URL=http://localhost:5173
# Optional comma-separated origins for production (e.g. https://campusvoice.example.edu,https://admin.example.edu)
# Wildcards ('*') are strictly disallowed when credentials are enabled.
# CORS_ALLOWED_ORIGINS=https://campusvoice.example.edu


# JWT Authentication Settings
JWT_SECRET_KEY=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local Development Admin Seed Credentials (Optional)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-local-development-password
