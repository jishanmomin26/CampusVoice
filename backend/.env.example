# ==============================================================================
# CampusVoice Backend Environment Configuration
# Copy this template to .env for local development.
# 
# CRITICAL SECURITY RULES:
# - NEVER commit .env to version control.
# - In PRODUCTION, values must be supplied via the hosting provider's secure
#   environment variable settings (e.g. AWS, Render, Fly.io, Railway, Kubernetes).
# - Production automatically rejects development placeholders and localhost URLs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Deployment Environment Mode
# ------------------------------------------------------------------------------
# Values: "development" (default), "production", or "testing"
# Setting ENVIRONMENT=production enforces strict validation:
# - Rejects development JWT secret placeholders and keys < 32 characters
# - Rejects local/localhost database connections
# - Requires explicitly configured, non-localhost CORS origins
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL with SQLAlchemy 2.x & psycopg driver)
# ------------------------------------------------------------------------------
# Development: Local PostgreSQL instance
DATABASE_URL=postgresql+psycopg://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/campusvoice
# Production Example (supplied via cloud environment variables, never localhost):
# DATABASE_URL=postgresql+psycopg://db_user:secure_remote_password@db.provider.internal:5432/campusvoice_prod

# ------------------------------------------------------------------------------
# 3. Frontend & CORS Configuration
# ------------------------------------------------------------------------------
# Development default origin:
FRONTEND_URL=http://localhost:5173

# Production Allowed Origins (comma-separated list, e.g. production domain):
# Wildcards ('*') are strictly disallowed when credentials are enabled.
# In production, at least one non-localhost origin must be configured.
# CORS_ALLOWED_ORIGINS=https://campusvoice.example.edu,https://admin.campusvoice.example.edu

# ------------------------------------------------------------------------------
# 4. JWT Authentication Settings
# ------------------------------------------------------------------------------
# Development: Fallback secret allowed for local testing only
# Production: MUST be a cryptographically strong secret with >= 32 characters
JWT_SECRET_KEY=replace-with-a-secure-random-secret-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 5. Admin Seed Credentials (Optional for local development setup)
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-local-development-password

# ------------------------------------------------------------------------------
# 6. Google Sign-In / OAuth Configuration (Step 9.19.1)
# ------------------------------------------------------------------------------
# Google Web Application OAuth 2.0 Client ID for OpenID Connect ID-token verification.
# Only the Client ID is required for server-side ID-token verification (no client secret).
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>

