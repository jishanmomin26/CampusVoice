# ==============================================================================
# CampusVoice Git Ignore Rules
# ==============================================================================

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- IDEs and Editors ---
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- Environment and Secret Files ---
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
*.local

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# --- Node.js & Frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
frontend/dist/
frontend/dist-ssr/
frontend/.cache/

# --- Machine Learning & Data ---
# Exclude large datasets and models, but retain folder structures and documentation
ml/datasets/*.csv
ml/datasets/*.tsv
ml/datasets/*.json
ml/datasets/*.jsonl
ml/datasets/*.parquet
ml/datasets/*.zip
ml/datasets/*.tar.gz
!ml/datasets/.gitkeep
!ml/datasets/README.md

ml/models/*.pkl
ml/models/*.joblib
!ml/models/tfidf_vectorizer.joblib
!ml/models/best_sentiment_model.joblib
!ml/models/best_category_model.joblib
ml/models/*.h5
ml/models/*.keras
ml/models/*.pt
ml/models/*.pth
ml/models/*.bin
ml/models/*.onnx
!ml/models/.gitkeep
!ml/models/README.md

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# NLTK Downloaded Corpora & Build Artifacts
nltk_data/
backend/nltk_data/
